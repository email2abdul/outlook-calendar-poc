# ─────────────────────────────────────────────────────────────────────────────
# Microsoft / Azure App Registration
# Get these from Azure Portal → App registrations → your app (see README).
# ─────────────────────────────────────────────────────────────────────────────

# Application (client) ID from the app registration Overview page.
MS_CLIENT_ID=your-application-client-id

# Client secret VALUE (not the secret ID) from Certificates & secrets.
MS_CLIENT_SECRET=your-client-secret-value

# Tenant for the authority.
#   common         -> work/school + personal Microsoft accounts (Outlook/Hotmail)  [recommended for this POC]
#   organizations  -> work/school accounts only
#   consumers      -> personal Microsoft accounts only
#   <tenant-id>    -> single tenant only
MS_TENANT_ID=common

# Must EXACTLY match a Redirect URI registered in Azure (Web platform).
REDIRECT_URI=http://localhost:3000/auth/callback

# Where to send the user after login completes.
POST_LOGIN_REDIRECT=/

# ─────────────────────────────────────────────────────────────────────────────
# App / Session
# ─────────────────────────────────────────────────────────────────────────────

# Long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Set to "production" when deploying behind HTTPS (enables Secure cookies).
NODE_ENV=development

# Deliver physician briefings to this Microsoft mailbox so they land in the
# Outlook Inbox (not Sent). Leave blank to use the signed-in address — but if
# that is a federated/Gmail address, Microsoft routes it externally and the
# briefing only appears in Sent. Set to your real outlook.com address.
BRIEFING_TO_EMAIL=

# Pre-meeting reminder engine.
#   REMINDER_LEAD_MINUTES — how long before a meeting the reminder fires (default 90).
#   REMINDER_POLL_SECONDS — how often the engine scans calendars (default 300=5min).
# A meeting scheduled to start within LEAD_MINUTES gets its reminder on the next
# poll, so a smaller poll = sooner reminder for imminent meetings. 60 → ~1 min.
REMINDER_POLL_SECONDS=60

# Email Intelligence Sheet — how many days of inbox history the backfill reads
# (start at 10, bump to 30 later). The live ingest keeps the sheet updated after.
EMAIL_INTEL_DAYS=10

# Email Intelligence self-heal — each ingest tick re-scans this many days of
# inbox and (re)processes any message that still has no sheet row, so a transient
# failure on first ingest doesn't leave an email permanently off the sheet
# (the inbox delta never resurfaces it). Default 3.
# INTEL_RECONCILE_DAYS=3

# Optional — serverless hosts only (Vercel). When set, sessions and meeting
# notes move from local SQLite to Redis (required there: instances are
# ephemeral). Leave unset for local dev and long-lived hosts like Render.
# REDIS_URL=rediss://default:password@your-upstash-host:6379

# ─────────────────────────────────────────────────────────────────────────────
# Pre-meeting reminders (salesperson briefing email before matched meetings)
# ─────────────────────────────────────────────────────────────────────────────

# Email the salesperson this many minutes before any physician-matched
# meeting (also used for the native Outlook reminder on created events).
# REMINDER_LEAD_MINUTES=90

# How often the engine scans signed-in users' calendars, in seconds.
# REMINDER_POLL_SECONDS=300

# Set to "false" to turn the reminder engine off entirely.
# REMINDERS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Email-intelligence ingestion (Phase 0/1: calendar→CRM sync + reply ingest)
# ─────────────────────────────────────────────────────────────────────────────

# How often (seconds) to sync activities and pull new Outlook replies.
# INGEST_POLL_SECONDS=300
# Set to "false" to turn ingestion off.
# INGEST_ENABLED=true
# Shared secret echoed in Graph webhook notifications (production only).
# GRAPH_WEBHOOK_SECRET=some-long-random-string

# Supabase Data API — physician directory + procedure analytics (bis_* tables,
# read-only via the bis_directory / bis_physician_analytics SQL functions) AND
# this app's own data (app_* tables). When unset, the directory falls back to
# the bundled CSVs and analytics to data/analytics.db (or disabled).
# Dashboard → Project Settings → API.
#
# Two targets live side by side. SUPABASE_ENV picks the active one — flip it
# between `development` and `production` and the whole app follows; no other
# change needed. Defaults to `production` when unset.
# IMPORTANT: setting SUPABASE_ENV alone is not enough — the matching per-env
# pair below must be set, or the app silently falls back to the legacy flat
# vars. Confirm the boot log: "[supabase] client created (env=…, https://…)".
SUPABASE_ENV=development

SUPABASE_DEV_URL=https://<dev-ref>.supabase.co
SUPABASE_DEV_ANON_KEY=<dev anon/publishable key>
# Service-role key used only by admin/seed scripts (bypasses RLS), not the app.
SUPABASE_DEV_SERVICE_ROLE_KEY=<dev service-role key>

SUPABASE_PROD_URL=https://<prod-ref>.supabase.co
SUPABASE_PROD_ANON_KEY=<prod anon/publishable key>

# Legacy flat vars still work as a fallback when the per-env ones are unset:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon/publishable key>

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (Claude) — AI extraction
# ─────────────────────────────────────────────────────────────────────────────
#
# Powers all AI in the platform (Claude claude-opus-4-8, forced tool-use):
#   - src/ai-extractor.js   — each Outlook reply → a Meeting Note (MOM)
#   - src/intel-extractor.js — each email → Email Intelligence Sheet fields
#   - scripts/ingest-products.js — Lumendi brochure PDFs → config/product-context.json
# The first two run inside the live background ingest engine; the third is a
# one-off script (npm run ingest:products a.pdf b.pdf, or drop PDFs in ./brochures/).
# All no-op gracefully when this is unset, so the app runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# Dynamics 365 (Dataverse) — read Lead records into the app (👥 Leads button)
# ─────────────────────────────────────────────────────────────────────────────
#
# App-only (client-credentials) read of Lead records. This uses its OWN app
# registration in the Entra tenant that OWNS the Dynamics org — NOT the Outlook
# app above. The app authenticates as itself (no user sign-in), so it does not
# matter which account is signed into Outlook.
#
# Setup (do it all signed in as the Dynamics tenant admin):
#   1. portal.azure.com → Entra ID → App registrations → New registration
#      (single tenant). Copy Application (client) ID + Directory (tenant) ID,
#      then Certificates & secrets → New client secret → copy the Value.
#   2. admin.powerplatform.microsoft.com → your environment → Settings →
#      Users + permissions → Application users → New app user → add the app →
#      assign a security role that can READ Lead (e.g. Salesperson).
#   3. Fill in the four vars below.
# Leave any of these blank to disable the feature (the Leads list stays empty).
DYNAMICS_URL=https://<org>.crm.dynamics.com
DYNAMICS_TENANT_ID=<Directory (tenant) ID>
DYNAMICS_CLIENT_ID=<Application (client) ID>
DYNAMICS_CLIENT_SECRET=<client secret Value>

# Part 2 — embed the lead BIS brief INSIDE Dynamics 365 (side pane / iframe).
# The /embed/lead-brief endpoint has no Outlook session, so a shared token gates
# it. Put the SAME token in the Dynamics web resource that builds the iframe URL.
# frame-ancestors controls which origins may iframe the page (defaults cover any
# *.dynamics.com). Leave DYNAMICS_EMBED_TOKEN unset to disable the embed (403).
DYNAMICS_EMBED_TOKEN=<a long random string — same value in the Dynamics web resource>
# DYNAMICS_EMBED_FRAME_ANCESTORS=https://orgfa1d2553.crm.dynamics.com
