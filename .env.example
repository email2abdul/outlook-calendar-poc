# ─────────────────────────────────────────────────────────────────────────────
# Microsoft / Azure App Registration
# Get these from Azure Portal → App registrations → your app (see README).
# ─────────────────────────────────────────────────────────────────────────────

# Application (client) ID from the app registration Overview page.
MS_CLIENT_ID=your-application-client-id

# Client secret VALUE (not the secret ID) from Certificates & secrets.
MS_CLIENT_SECRET=your-client-secret-value

# Tenant for the authority.
#   common         -> work/school + personal Microsoft accounts (Outlook/Hotmail)  [recommended for this POC]
#   organizations  -> work/school accounts only
#   consumers      -> personal Microsoft accounts only
#   <tenant-id>    -> single tenant only
MS_TENANT_ID=common

# Must EXACTLY match a Redirect URI registered in Azure (Web platform).
REDIRECT_URI=http://localhost:3000/auth/callback

# Where to send the user after login completes.
POST_LOGIN_REDIRECT=/

# ─────────────────────────────────────────────────────────────────────────────
# App / Session
# ─────────────────────────────────────────────────────────────────────────────

# Long random string used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Set to "production" when deploying behind HTTPS (enables Secure cookies).
NODE_ENV=development

# Deliver physician briefings to this Microsoft mailbox so they land in the
# Outlook Inbox (not Sent). Leave blank to use the signed-in address — but if
# that is a federated/Gmail address, Microsoft routes it externally and the
# briefing only appears in Sent. Set to your real outlook.com address.
BRIEFING_TO_EMAIL=

# Pre-meeting reminder engine.
#   REMINDER_LEAD_MINUTES — how long before a meeting the reminder fires (default 90).
#   REMINDER_POLL_SECONDS — how often the engine scans calendars (default 300=5min).
# A meeting scheduled to start within LEAD_MINUTES gets its reminder on the next
# poll, so a smaller poll = sooner reminder for imminent meetings. 60 → ~1 min.
REMINDER_POLL_SECONDS=60

# Optional — serverless hosts only (Vercel). When set, sessions and meeting
# notes move from local SQLite to Redis (required there: instances are
# ephemeral). Leave unset for local dev and long-lived hosts like Render.
# REDIS_URL=rediss://default:password@your-upstash-host:6379

# ─────────────────────────────────────────────────────────────────────────────
# Pre-meeting reminders (salesperson briefing email before matched meetings)
# ─────────────────────────────────────────────────────────────────────────────

# Email the salesperson this many minutes before any physician-matched
# meeting (also used for the native Outlook reminder on created events).
# REMINDER_LEAD_MINUTES=90

# How often the engine scans signed-in users' calendars, in seconds.
# REMINDER_POLL_SECONDS=300

# Set to "false" to turn the reminder engine off entirely.
# REMINDERS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Email-intelligence ingestion (Phase 0/1: calendar→CRM sync + reply ingest)
# ─────────────────────────────────────────────────────────────────────────────

# How often (seconds) to sync activities and pull new Outlook replies.
# INGEST_POLL_SECONDS=300
# Set to "false" to turn ingestion off.
# INGEST_ENABLED=true
# Shared secret echoed in Graph webhook notifications (production only).
# GRAPH_WEBHOOK_SECRET=some-long-random-string

# Optional — Supabase Data API for the physician directory + procedure
# analytics (bis_* tables, read-only via the bis_directory and
# bis_physician_analytics SQL functions). When unset, the directory falls
# back to the bundled CSVs and analytics to data/analytics.db (or disabled).
# Dashboard → Project Settings → API.
#
# Two targets live side by side. SUPABASE_ENV picks the active one — flip it
# between `development` and `production` and the whole app follows; no other
# change needed. Defaults to `production` when unset.
# SUPABASE_ENV=development
#
# SUPABASE_PROD_URL=https://<prod-ref>.supabase.co
# SUPABASE_PROD_ANON_KEY=<prod anon/publishable key>
#
# SUPABASE_DEV_URL=https://<dev-ref>.supabase.co
# SUPABASE_DEV_ANON_KEY=<dev anon/publishable key>
# Service-role key used only by admin/seed scripts (bypasses RLS), not the app.
# SUPABASE_DEV_SERVICE_ROLE_KEY=<dev service-role key>
#
# Legacy flat vars still work as a fallback when the per-env ones are unset:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon/publishable key>

# ─────────────────────────────────────────────────────────────────────────────
# Product Context Layer (briefing "What to Discuss" — Lumendi product matching)
# ─────────────────────────────────────────────────────────────────────────────
#
# Used ONLY by `npm run ingest:products`, which reads the Lumendi brochure PDFs
# and extracts structured product knowledge into config/product-context.json via
# Claude (forced tool-use). The running app does NOT call the API — it reads the
# generated JSON. Re-run ingest only when the brochures change.
#
#   npm run ingest:products path/to/a.pdf path/to/b.pdf   (or drop PDFs in ./brochures/)
#
# ANTHROPIC_API_KEY=sk-ant-...
